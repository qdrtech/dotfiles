/* Generated by theme-switch.sh */
* {
    background-color: #0f1115;
    text-color: #e8e8ed;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    background-color: #1c1f26;
    border: 1px;
    border-color: #0a84ff;
    padding: 12px;
    width: 600px;
}

mainbox {
    padding: 8px;
}

listview {
    lines: 8;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 8px 10px;
    spacing: 8px;
}

element normal.normal {
    background-color: transparent;
    text-color: #e8e8ed;
}

element selected.normal {
    background-color: #0a84ff;
    text-color: #0b1221;
}

element-icon {
    size: 18px;
}
