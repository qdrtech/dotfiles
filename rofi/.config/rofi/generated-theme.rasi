/* Generated by theme-switch.sh */
* {
    background-color: #1e1e2e;
    text-color: #cdd6f4;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    background-color: #313244;
    border: 1px;
    border-color: #89b4fa;
    padding: 12px;
    width: 600px;
}

mainbox {
    padding: 8px;
}

listview {
    lines: 8;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 8px 10px;
    spacing: 8px;
}

element normal.normal {
    background-color: transparent;
    text-color: #cdd6f4;
}

element selected.normal {
    background-color: #89b4fa;
    text-color: #0b1221;
}

element-icon {
    size: 18px;
}
