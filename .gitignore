# Add claude folder 
.claude/

# Generated by scripts/theme-switch.sh. These $HOME directories are folded stow
# symlinks into this repo, so the switcher writes its output straight into the
# working tree. Regenerate with: ts set <theme>
ghostty/.config/ghostty/theme.conf
rofi/.config/rofi/theme-colors.rasi
rofi/.config/rofi/generated-theme.rasi
swaync/.config/swaync/theme-colors.css

# Written by the switcher into ~/.config/themes, which lands in the repo if stow
# folds that directory.
themes/.config/themes/current
themes/.config/themes/colors.conf
themes/.config/themes/current.txt
