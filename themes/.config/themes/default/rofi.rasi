/**
 * Default Theme - Rofi Configuration
 * Version: 1.0
 * This file will be expanded in Phase 2
 */

/* ==============================================================================
 * COLORS
 * ============================================================================*/

* {
    bg-window:      rgba(45, 45, 45, 0.75);
    bg-elevated:    #323232;
    fg-primary:     rgba(255, 255, 255, 0.87);
    fg-secondary:   rgba(160, 160, 160, 0.55);
    accent-blue:    #0A84FF;
    border-color:   #3C3C3C;

    background-color: transparent;
    text-color:       @fg-primary;

    font: "SF Pro Text 14px";
}

/* ==============================================================================
 * WINDOW
 * ============================================================================*/

window {
    background-color: @bg-window;
    border:           1px solid @border-color;
    border-radius:    12px;
    padding:          16px;
    width:            600px;
}

/* ==============================================================================
 * INPUTBAR
 * ============================================================================*/

inputbar {
    background-color: @bg-elevated;
    border-radius:    8px;
    padding:          12px 16px;
    margin:           0 0 12px 0;
    children:         [ prompt, entry ];
}

prompt {
    enabled: false;
}

entry {
    placeholder:       "Search applications...";
    placeholder-color: #545454;
}

/* ==============================================================================
 * LISTVIEW
 * ============================================================================*/

listview {
    lines:      8;
    spacing:    2px;
    scrollbar:  false;
}

/* ==============================================================================
 * ELEMENTS
 * ============================================================================*/

element {
    padding:       10px 12px;
    border-radius: 6px;
    spacing:       12px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg-primary;
}

element selected.normal {
    background-color: @accent-blue;
    text-color:       #FFFFFF;
}

element-icon {
    size: 24px;
}

element-text {
    vertical-align: 0.5;
}
